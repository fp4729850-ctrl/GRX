generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id           String   @id
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  details      String   @db.Text
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  users        users?   @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@index([resourceType])
  @@index([userId])
}

model certificates {
  id           String              @id
  certId       String              @unique
  grams        Decimal             @db.Decimal(18, 8)
  mintTxHash   String?
  createdAt    DateTime            @default(now())
  mintedAt     DateTime?
  mintedBy     String?
  payload      String              @db.Text
  payloadHash  String
  signature    String?
  status       certificates_status @default(PENDING)
  updatedAt    DateTime
  vaultCertId  String
  vaultPartner String

  @@index([certId])
  @@index([status])
  @@index([vaultPartner])
}

model invoices {
  id                 String          @id
  invoiceId          String          @unique
  recipient          String
  amount             Decimal         @db.Decimal(18, 8)
  status             invoices_status @default(RECEIVED)
  transferTxHash     String?
  burnTxHash         String?
  partnerId          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime
  burnBlockNumber    BigInt?
  burnTimestamp      DateTime?
  expiresAt          DateTime?
  oracleSnapshotId   String?
  payoutTxHash       String?
  settlementAmount   Decimal?        @db.Decimal(18, 8)
  settlementCurrency String?
  userId             String
  users              users           @relation(fields: [userId], references: [id], onDelete: Cascade)
  settlements        settlements?

  @@index([invoiceId])
  @@index([recipient])
  @@index([status])
  @@index([userId])
}

model kyc_documents {
  id           String               @id
  userId       String
  documentType String
  documentHash String
  fileName     String
  mimeType     String
  status       kyc_documents_status @default(PENDING)
  verifiedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime
  users        users                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentHash])
  @@index([userId])
}

model mint_proposals {
  id         String                @id
  proposalId String                @unique
  userId     String
  certId     String
  to         String
  amount     Decimal               @db.Decimal(18, 8)
  metadata   String?               @db.Text
  status     mint_proposals_status @default(PENDING)
  signatures String                @db.Text
  executedAt DateTime?
  txHash     String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime
  users      users                 @relation(fields: [userId], references: [id])

  @@index([proposalId])
  @@index([status])
  @@index([userId], map: "mint_proposals_userId_fkey")
}

model oracle_snapshots {
  id           String        @id
  timestamp    DateTime
  blockNumber  BigInt?
  goldPriceUSD Decimal       @db.Decimal(18, 8)
  fxRates      String        @db.Text
  signature    String?
  source       String
  createdAt    DateTime      @default(now())
  settlements  settlements[]

  @@index([timestamp])
}

model partners {
  id                  String          @id
  name                String
  apiKey              String          @unique
  apiKeyHash          String
  webhookUrl          String?
  ipAllowlist         String?         @db.Text
  supportedCurrencies String          @db.Text
  status              partners_status @default(ACTIVE)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime
  settlements         settlements[]

  @@index([apiKeyHash])
  @@index([status])
}

model proof_of_reserve {
  id             String   @id
  merkleRoot     String   @unique
  blockNumber    BigInt?
  txHash         String?
  certificateIds String   @db.Text
  totalGrams     Decimal  @db.Decimal(18, 8)
  signature      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([merkleRoot])
}

model settlements {
  id               String             @id
  invoiceId        String             @unique
  partnerId        String
  amount           Decimal            @db.Decimal(18, 8)
  currency         String
  fxRate           Decimal            @db.Decimal(18, 8)
  goldPrice        Decimal            @db.Decimal(18, 8)
  oracleSnapshotId String
  settlementPacket String             @db.Text
  status           settlements_status @default(PENDING)
  payoutTxHash     String?
  confirmedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  invoices         invoices           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  oracle_snapshots oracle_snapshots   @relation(fields: [oracleSnapshotId], references: [id])
  partners         partners           @relation(fields: [partnerId], references: [id])

  @@index([invoiceId])
  @@index([oracleSnapshotId])
  @@index([partnerId])
  @@index([status])
}

model users {
  id               String           @id
  email            String           @unique
  phone            String?          @unique
  passwordHash     String
  role             users_role       @default(INDIVIDUAL)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  biometricEnabled Boolean          @default(false)
  firstName        String?
  kycStatus        users_kycStatus  @default(PENDING)
  kycVerifiedAt    DateTime?
  lastName         String?
  twoFactorEnabled Boolean          @default(false)
  twoFactorSecret  String?
  audit_logs       audit_logs[]
  invoices         invoices[]
  kyc_documents    kyc_documents[]
  mint_proposals   mint_proposals[]
  wallets          wallets[]

  @@index([email])
  @@index([phone])
}

model wallets {
  id                  String   @id
  address             String   @unique
  userId              String
  createdAt           DateTime @default(now())
  isCustodial         Boolean  @default(false)
  isTestnet           Boolean  @default(true)
  network             String   @default("POLYGON")
  privateKeyEncrypted String?
  updatedAt           DateTime
  users               users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([address])
  @@index([userId])
}

enum invoices_status {
  RECEIVED
  AWAITING_REDEEM
  BURN_PENDING
  USED
  SETTLED
  EXPIRED
}

enum users_role {
  INDIVIDUAL
  INSTITUTIONAL
  PARTNER
  ADMIN
}

enum kyc_documents_status {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
  EXPIRED
}

enum mint_proposals_status {
  PENDING
  APPROVED
  EXECUTED
  REJECTED
  EXPIRED
}

enum partners_status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum users_kycStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
  EXPIRED
}

enum settlements_status {
  PENDING
  SENT
  CONFIRMED
  FAILED
}

enum certificates_status {
  PENDING
  VERIFIED
  MINTED
  REJECTED
}
